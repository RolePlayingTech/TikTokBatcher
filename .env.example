# Input / output paths (relative to project root).
# Each video in VIDEOS_DIR may have a sidecar .txt file with the same basename
# containing the caption, e.g. filmy/01.mp4 + filmy/01.txt
VIDEOS_DIR=./filmy
PLAN_FILE=./schedule/plan.yaml
STATE_DIR=./state

# TikTok Studio upload URL
STUDIO_URL=https://www.tiktok.com/tiktokstudio/upload?from=creator_center

# Maximum uploads per single `npm run upload` run. 0 = no limit.
# Lower value (e.g. 10) makes each session shorter and more human-like.
MAX_UPLOADS_PER_RUN=0

# Videos per day + daily posting times (HH:mm, local timezone below).
# Length of POSTING_TIMES should match VIDEOS_PER_DAY.
VIDEOS_PER_DAY=3
POSTING_TIMES=09:00,14:00,19:00

# IANA timezone used for schedule planning
TIMEZONE=Europe/Warsaw

# Before uploading, scrape TikTok Studio's content page to detect videos
# already posted on your account (matched by caption hash). Set to false if
# the scrape is slow / flaky for you — local file-hash dedup still works.
REMOTE_DUPLICATE_CHECK=true
